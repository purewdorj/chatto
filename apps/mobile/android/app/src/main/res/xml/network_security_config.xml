<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, with the system certificate store. User-installed CAs are
     trusted only in debug builds, for a local development server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
