{
  "appId": "mn.setunari.chatto.mobile",
  "appName": "Setunari Chat",
  "webDir": "www",
  "loggingBehavior": "none",
  "server": {
    "hostname": "localhost",
    "iosScheme": "capacitor",
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "never"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": false
  },
  "plugins": {
    "Keyboard": {
      "resize": "none"
    },
    "PushNotifications": {
      "presentationOptions": ["banner", "sound", "badge"]
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover"
    }
  }
}
