# Copy to ad-sync.env (chmod 600). Do not commit the real file.
# The file is loaded with `. ad-sync.env`: put values that contain spaces in double quotes.

# --- Active Directory (read-only service account is enough)
AD_LDAP_URL=ldaps://dc01.setunari.local:636
AD_BIND_DN="CN=svc-chatto,OU=Service Accounts,DC=setunari,DC=local"
AD_BIND_PASSWORD_FILE=/etc/setunari/ad-sync/ad-password
# Empty: the domain root (defaultNamingContext). Or an OU, for example OU=Users,DC=example,DC=local
AD_BASE_DN=
# Optional: CA of the domain controllers' LDAPS certificate.
#AD_CA_FILE=/etc/setunari/ad-sync/ad-ca.pem
# Optional: only members of this group (nested groups count) are current employees.
#AD_EMPLOYEE_GROUP_DN="CN=Chat Users,OU=Groups,DC=setunari,DC=local"
# Optional: OUs for people who left, separated by ';'.
#AD_EXCLUDE_OUS="OU=Disabled Users,DC=setunari,DC=local"
# AD attribute that equals the Chatto login (the IdP's preferred_username).
AD_LOGIN_ATTR=sAMAccountName
# Fallback match against the Chatto user's verified emails.
AD_EMAIL_ATTRS=mail,userPrincipalName

# --- Chatto
CHATTO_URL=https://chat.setunari-group.com
CHATTO_TOKEN_FILE=/etc/setunari/ad-sync/chatto-bot-key
# Chatto logins the sync never touches (local admins, test accounts).
ADSYNC_KEEP_LOGINS=admin
# Chatto accounts without an AD account: ignore (default) or deactivate.
ADSYNC_UNMATCHED=ignore
# Stop without changes when more accounts would be deactivated (override: --force).
ADSYNC_MAX_DEACTIVATIONS=25
ADSYNC_STATE_FILE=/var/lib/setunari-ad-sync/state.json
